# Production domain (enables canonical URL, sitemap, OG absolute URLs, JSON-LD url)
NEXT_PUBLIC_SITE_URL=

# Contact (CTAs are hidden in production until at least one of email / WhatsApp is set)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social profiles (HTTPS only; invalid values render nothing)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=


# "true" shows placeholder brands + dev contact placeholder in a production build (e.g. Vercel Preview)
NEXT_PUBLIC_SHOW_DEV_PLACEHOLDERS=
